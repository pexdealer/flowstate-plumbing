{
  "name": "Estimate",
  "type": "object",
  "properties": {
    "estimate_number": {
      "type": "string",
      "description": "Unique estimate number"
    },
    "customer_id": {
      "type": "string",
      "description": "Reference to the customer"
    },
    "customer_name": {
      "type": "string",
      "description": "Customer name for display"
    },
    "customer_address": {
      "type": "string",
      "description": "Job site address"
    },
    "customer_email": {
      "type": "string",
      "description": "Customer email used to deliver this proposal"
    },
    "customer_phone": {
      "type": "string",
      "description": "Customer phone used for job communication"
    },
    "job_type": {
      "type": "string",
      "enum": [
        "repair",
        "installation",
        "maintenance",
        "remodel",
        "new_construction",
        "emergency",
        "inspection",
        "other"
      ],
      "description": "Type of plumbing job"
    },
    "job_description": {
      "type": "string",
      "description": "Description of the work"
    },
    "line_items": {
      "type": "array",
      "description": "Materials and labor line items",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "material",
              "labor",
              "equipment",
              "other"
            ]
          },
          "item_id": {
            "type": "string",
            "description": "Optional link to an InventoryItem for stock deduction"
          },
          "sku": {
            "type": "string",
            "description": "SKU of the linked inventory item"
          },
          "description": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          },
          "total": {
            "type": "number"
          }
        }
      }
    },
    "subtotal": {
      "type": "number"
    },
    "markup_percent": {
      "type": "number",
      "description": "Markup percentage"
    },
    "markup_amount": {
      "type": "number"
    },
    "tax_percent": {
      "type": "number"
    },
    "tax_amount": {
      "type": "number"
    },
    "total": {
      "type": "number",
      "description": "Grand total"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "sent",
        "approved",
        "declined",
        "expired"
      ],
      "default": "draft"
    },
    "valid_until": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string",
      "description": "Internal notes; never shown on the customer proposal"
    },
    "customer_notes": {
      "type": "string",
      "description": "Notes intentionally shown on the customer proposal"
    },
    "public_token": {
      "type": "string",
      "description": "Unguessable token used to build the customer-facing proposal link"
    },
    "public_token_revoked_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the customer-facing proposal link was revoked"
    },
    "active_proposal_version_id": {
      "type": "string",
      "description": "Current immutable ProposalVersion shown to the customer"
    },
    "proposal_version_number": {
      "type": "number",
      "default": 0
    },
    "delivery_channel": {
      "type": "string",
      "enum": ["email", "manual_link"]
    },
    "delivery_status": {
      "type": "string",
      "enum": ["prepared", "delivered", "failed"]
    },
    "sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the proposal link was sent to the customer"
    },
    "viewed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the customer first opened the proposal link"
    },
    "accepted_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the customer accepted the estimate"
    },
    "accepted_by_name": {
      "type": "string",
      "description": "Typed name the customer signed with when accepting"
    },
    "accepted_signature": {
      "type": "string",
      "description": "Captured e-signature text"
    },
    "accepted_ip": {
      "type": "string",
      "description": "IP address recorded at acceptance for the audit trail"
    },
    "declined_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the customer declined the estimate"
    },
    "job_id": {
      "type": "string",
      "description": "Job that was auto-created when the customer accepted"
    }
  },
  "required": [
    "customer_name",
    "job_type"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
