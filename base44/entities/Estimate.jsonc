{
  "name": "Estimate",
  "type": "object",
  "properties": {
    "estimate_number": {
      "type": "string",
      "description": "Unique estimate number"
    },
    "customer_id": {
      "type": "string",
      "description": "Reference to the customer"
    },
    "customer_name": {
      "type": "string",
      "description": "Customer name for display"
    },
    "customer_address": {
      "type": "string",
      "description": "Job site address"
    },
    "job_type": {
      "type": "string",
      "enum": [
        "repair",
        "installation",
        "maintenance",
        "remodel",
        "new_construction",
        "emergency",
        "inspection",
        "other"
      ],
      "description": "Type of plumbing job"
    },
    "job_description": {
      "type": "string",
      "description": "Description of the work"
    },
    "line_items": {
      "type": "array",
      "description": "Materials and labor line items",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "material",
              "labor",
              "equipment",
              "other"
            ]
          },
          "description": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          },
          "total": {
            "type": "number"
          }
        }
      }
    },
    "subtotal": {
      "type": "number"
    },
    "markup_percent": {
      "type": "number",
      "description": "Markup percentage"
    },
    "markup_amount": {
      "type": "number"
    },
    "tax_percent": {
      "type": "number"
    },
    "tax_amount": {
      "type": "number"
    },
    "total": {
      "type": "number",
      "description": "Grand total"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "sent",
        "approved",
        "declined",
        "expired"
      ],
      "default": "draft"
    },
    "valid_until": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string",
      "description": "Internal or customer-facing notes"
    }
  },
  "required": [
    "customer_name",
    "job_type"
  ]
}