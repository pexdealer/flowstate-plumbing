{
  "name": "Invoice",
  "type": "object",
  "properties": {
    "invoice_number": {
      "type": "string",
      "description": "Unique invoice number e.g. INV-001"
    },
    "job_id": {
      "type": "string",
      "description": "Job this invoice is for"
    },
    "estimate_id": {
      "type": "string",
      "description": "Original estimate reference"
    },
    "estimate_number": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "customer_address": {
      "type": "string"
    },
    "customer_phone": {
      "type": "string"
    },
    "customer_email": {
      "type": "string",
      "description": "Customer email address for sending the invoice"
    },
    "job_type": {
      "type": "string"
    },
    "job_description": {
      "type": "string"
    },
    "line_items": {
      "type": "array",
      "description": "Line items copied from the estimate",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "material",
              "labor",
              "equipment",
              "other"
            ]
          },
          "description": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          },
          "total": {
            "type": "number"
          }
        }
      }
    },
    "subtotal": {
      "type": "number"
    },
    "markup_percent": {
      "type": "number"
    },
    "markup_amount": {
      "type": "number"
    },
    "tax_percent": {
      "type": "number"
    },
    "tax_amount": {
      "type": "number"
    },
    "total": {
      "type": "number"
    },
    "total_cents": {
      "type": "number",
      "description": "Invoice total stored as integer cents for payment reconciliation"
    },
    "amount_paid_cents": {
      "type": "number",
      "default": 0
    },
    "balance_due_cents": {
      "type": "number"
    },
    "payment_status": {
      "type": "string",
      "enum": ["unpaid", "partial", "paid", "refunded"],
      "default": "unpaid"
    },
    "payment_link": {
      "type": "string",
      "description": "Stripe-hosted payment URL; never a raw card form"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "sent",
        "paid",
        "overdue"
      ],
      "default": "draft"
    },
    "public_token": {
      "type": "string",
      "description": "Unguessable token for the customer-facing invoice link"
    },
    "public_token_expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Optional expiration time for the customer-facing invoice link"
    },
    "public_token_revoked_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the customer-facing invoice link was revoked"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "description": "Payment due date"
    },
    "sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "viewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "paid_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string",
      "description": "Internal invoice notes; never shown to customers"
    },
    "customer_notes": {
      "type": "string",
      "description": "Notes intentionally shown on the customer invoice"
    },
    "photos_before": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Before photos \u2014 array of file URLs"
    },
    "photos_after": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "After photos \u2014 array of file URLs"
    }
  },
  "required": [
    "customer_name",
    "job_id",
    "total"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
