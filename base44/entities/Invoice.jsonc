{
  "name": "Invoice",
  "type": "object",
  "properties": {
    "invoice_number": {
      "type": "string",
      "description": "Unique invoice number e.g. INV-001"
    },
    "job_id": {
      "type": "string",
      "description": "Job this invoice is for"
    },
    "estimate_id": {
      "type": "string",
      "description": "Original estimate reference"
    },
    "estimate_number": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "customer_address": {
      "type": "string"
    },
    "customer_phone": {
      "type": "string"
    },
    "job_type": {
      "type": "string"
    },
    "job_description": {
      "type": "string"
    },
    "line_items": {
      "type": "array",
      "description": "Line items copied from the estimate",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "material",
              "labor",
              "equipment",
              "other"
            ]
          },
          "description": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          },
          "total": {
            "type": "number"
          }
        }
      }
    },
    "subtotal": {
      "type": "number"
    },
    "markup_percent": {
      "type": "number"
    },
    "markup_amount": {
      "type": "number"
    },
    "tax_percent": {
      "type": "number"
    },
    "tax_amount": {
      "type": "number"
    },
    "total": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "sent",
        "paid",
        "overdue"
      ],
      "default": "draft"
    },
    "public_token": {
      "type": "string",
      "description": "Unguessable token for the customer-facing invoice link"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "description": "Payment due date"
    },
    "sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "viewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "paid_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "customer_name",
    "job_id",
    "total"
  ]
}