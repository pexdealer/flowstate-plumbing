{
  "name": "Job",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Short job title shown on the calendar and dispatch board"
    },
    "estimate_id": {
      "type": "string",
      "description": "Estimate this job was created from"
    },
    "estimate_number": {
      "type": "string",
      "description": "Human-friendly estimate number for reference"
    },
    "customer_id": {
      "type": "string",
      "description": "Reference to the customer"
    },
    "customer_name": {
      "type": "string"
    },
    "customer_phone": {
      "type": "string"
    },
    "customer_address": {
      "type": "string",
      "description": "Job site address (used as the calendar event location)"
    },
    "job_type": {
      "type": "string",
      "enum": [
        "repair",
        "installation",
        "maintenance",
        "remodel",
        "new_construction",
        "emergency",
        "inspection",
        "other"
      ]
    },
    "job_description": {
      "type": "string"
    },
    "line_items": {
      "type": "array",
      "description": "Parts and labor on this job; inventory-linked lines drive stock deduction",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "material",
              "labor",
              "equipment",
              "other"
            ]
          },
          "item_id": {
            "type": "string",
            "description": "Optional link to an InventoryItem for stock deduction"
          },
          "sku": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          },
          "total": {
            "type": "number"
          }
        }
      }
    },
    "parts_confirmed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Last time parts usage was confirmed and stock deducted"
    },
    "total": {
      "type": "number",
      "description": "Accepted total for the job"
    },
    "status": {
      "type": "string",
      "enum": [
        "unscheduled",
        "scheduled",
        "dispatched",
        "in_progress",
        "completed",
        "canceled"
      ],
      "default": "unscheduled",
      "description": "Dispatch status of the job"
    },
    "assigned_to": {
      "type": "string",
      "description": "Email or name of the technician the job is dispatched to"
    },
    "scheduled_start": {
      "type": "string",
      "format": "date-time",
      "description": "When the job is scheduled to start"
    },
    "scheduled_end": {
      "type": "string",
      "format": "date-time",
      "description": "When the job is scheduled to end"
    },
    "calendar_provider": {
      "type": "string",
      "enum": [
        "none",
        "google",
        "outlook",
        "ics"
      ],
      "default": "none",
      "description": "Which calendar the job was added to"
    },
    "calendar_event_id": {
      "type": "string",
      "description": "External calendar event id, when a native integration creates it"
    },
    "notes": {
      "type": "string"
    },
    "photos_before": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Before photos \u2014 array of file URLs"
    },
    "photos_after": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "After photos \u2014 array of file URLs"
    },
    "invoice_status": {
      "type": "string",
      "enum": [
        "none",
        "draft",
        "sent",
        "paid",
        "overdue"
      ],
      "default": "none",
      "description": "Invoice lifecycle status"
    },
    "invoice_id": {
      "type": "string",
      "description": "Linked Invoice record ID"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.assigned_to": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.assigned_to": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
