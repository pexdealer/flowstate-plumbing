{
  "name": "ProposalVersion",
  "type": "object",
  "properties": {
    "estimate_id": {
      "type": "string",
      "description": "Estimate this immutable customer proposal was created from"
    },
    "version_number": {
      "type": "number"
    },
    "public_token": {
      "type": "string",
      "description": "Unguessable token scoped to this proposal version"
    },
    "document_hash": {
      "type": "string",
      "description": "SHA-256 hash of the exact customer-facing snapshot"
    },
    "snapshot": {
      "type": "object",
      "description": "Immutable customer-safe proposal content"
    },
    "status": {
      "type": "string",
      "enum": ["sent", "viewed", "approved", "declined", "expired", "revoked"],
      "default": "sent"
    },
    "delivery_channel": {
      "type": "string",
      "enum": ["email", "manual_link"]
    },
    "delivery_status": {
      "type": "string",
      "enum": ["prepared", "delivered", "failed"]
    },
    "sent_to": {
      "type": "string",
      "description": "Destination used for delivery"
    },
    "sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "viewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "accepted_at": {
      "type": "string",
      "format": "date-time"
    },
    "accepted_by_name": {
      "type": "string"
    },
    "accepted_ip": {
      "type": "string"
    },
    "accepted_user_agent": {
      "type": "string"
    },
    "declined_at": {
      "type": "string",
      "format": "date-time"
    },
    "revoked_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": ["estimate_id", "version_number", "public_token", "document_hash", "snapshot"],
  "rls": {
    "create": {
      "$or": [
        { "created_by_id": "{{user.id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "read": {
      "$or": [
        { "created_by_id": "{{user.id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "update": {
      "$or": [
        { "created_by_id": "{{user.id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "delete": {
      "user_condition": { "role": "admin" }
    }
  }
}
