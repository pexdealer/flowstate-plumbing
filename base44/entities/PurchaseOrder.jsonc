{
  "name": "PurchaseOrder",
  "type": "object",
  "properties": {
    "po_number": {
      "type": "string",
      "description": "Human-friendly PO number, e.g. PO-000012"
    },
    "supplier_id": {
      "type": "string",
      "description": "Reference to the Supplier"
    },
    "supplier_name": {
      "type": "string",
      "description": "Denormalized supplier name for display"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "sent",
        "partially_received",
        "received",
        "canceled"
      ],
      "default": "draft"
    },
    "line_items": {
      "type": "array",
      "description": "Items being ordered",
      "items": {
        "type": "object",
        "properties": {
          "item_id": {
            "type": "string"
          },
          "sku": {
            "type": "string"
          },
          "supplier_sku": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "qty_ordered": {
            "type": "number"
          },
          "qty_received": {
            "type": "number",
            "default": 0
          },
          "unit_cost": {
            "type": "number"
          },
          "total": {
            "type": "number"
          }
        }
      }
    },
    "subtotal": {
      "type": "number"
    },
    "expected_date": {
      "type": "string",
      "format": "date"
    },
    "sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "received_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "po_number"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
